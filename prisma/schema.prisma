generator client {
  provider = "prisma-client"
  output   = "../backend/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  PATIENT
  DOCTOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum AppointmentType {
  CONSULTATION
  FOLLOW_UP
  EMERGENCY
}

enum FollowUpStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ReminderType {
  APPOINTMENT
  FOLLOW_UP
  MEDICATION
  CUSTOM
}

enum ReminderStatus {
  PENDING
  SENT
  FAILED
  CANCELLED
}

enum CalendarProvider {
  GOOGLE
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  email        String     @unique
  passwordHash String
  firstName    String
  lastName     String
  phone        String?
  role         UserRole
  status       UserStatus @default(ACTIVE)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  patientProfile      PatientProfile?
  doctorProfile       DoctorProfile?
  calendarConnection  CalendarConnection?
  auditLogs           AuditLog[]          @relation("AuditActor")
  createdAppointments Appointment[]       @relation("AppointmentCreator")
  reminders           Reminder[]          @relation("ReminderRecipient")

  @@index([role])
  @@index([status])
  @@index([createdAt])
}

model PatientProfile {
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique @db.Uuid

  dateOfBirth           DateTime? @db.Date
  gender                Gender?
  bloodGroup            String?
  emergencyContactName  String?
  emergencyContactPhone String?
  address               String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  appointments Appointment[] @relation("PatientAppointments")

  @@index([dateOfBirth])
}

model DoctorProfile {
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique @db.Uuid

  specialization  String
  licenseNumber   String   @unique
  qualification   String?
  experienceYears Int?
  consultationFee Decimal? @db.Decimal(10, 2)
  bio             String?
  isAvailable     Boolean  @default(true)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  appointments Appointment[]        @relation("DoctorAppointments")
  availability DoctorAvailability[]

  @@index([specialization])
  @@index([isAvailable])
}

model DoctorAvailability {
  id       String @id @default(uuid()) @db.Uuid
  doctorId String @db.Uuid

  dayOfWeek Int
  startTime String
  endTime   String
  isActive  Boolean @default(true)

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  doctor DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@unique([doctorId, dayOfWeek, startTime, endTime])
  @@index([doctorId, dayOfWeek])
}

model Appointment {
  id String @id @default(uuid()) @db.Uuid

  patientId   String @db.Uuid
  doctorId    String @db.Uuid
  createdById String @db.Uuid

  startTime DateTime @db.Timestamptz(3)
  endTime   DateTime @db.Timestamptz(3)

  type   AppointmentType   @default(CONSULTATION)
  status AppointmentStatus @default(SCHEDULED)

  reason             String?
  notes              String?
  cancellationReason String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  patient   PatientProfile @relation("PatientAppointments", fields: [patientId], references: [id], onDelete: Restrict)
  doctor    DoctorProfile  @relation("DoctorAppointments", fields: [doctorId], references: [id], onDelete: Restrict)
  createdBy User           @relation("AppointmentCreator", fields: [createdById], references: [id], onDelete: Restrict)

  followUps       FollowUp[]
  reminders       Reminder[]
  preVisitSummary PreVisitSummary?

  @@unique([doctorId, startTime])
  @@index([patientId, startTime])
  @@index([doctorId, startTime])
  @@index([status, startTime])
  @@index([startTime, endTime])
}

model PreVisitSummary {
  id                 String   @id @default(uuid()) @db.Uuid
  appointmentId      String   @unique @db.Uuid

  symptoms           String
  duration           String?
  additionalDetails  String?

  urgencyLevel       String
  chiefComplaint     String

  suggestedQuestions Json

  generatedBy        String   @default("LLM")
  createdAt          DateTime @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime @updatedAt @db.Timestamptz(3)

    appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([urgencyLevel])
  @@index([createdAt])
}

model FollowUp {
  id            String @id @default(uuid()) @db.Uuid
  appointmentId String @db.Uuid

  scheduledAt DateTime?      @db.Timestamptz(3)
  status      FollowUpStatus @default(PENDING)

  instructions String?
  patientNotes String?
  doctorNotes  String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  reminders   Reminder[]

  @@index([appointmentId])
  @@index([status, scheduledAt])
}

model Reminder {
  id String @id @default(uuid()) @db.Uuid

  appointmentId   String? @db.Uuid
  followUpId      String? @db.Uuid
  recipientUserId String  @db.Uuid

  type   ReminderType
  status ReminderStatus @default(PENDING)

  scheduledFor DateTime  @db.Timestamptz(3)
  sentAt       DateTime? @db.Timestamptz(3)

  title   String
  message String

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  followUp    FollowUp?    @relation(fields: [followUpId], references: [id], onDelete: Cascade)
  recipient   User         @relation("ReminderRecipient", fields: [recipientUserId], references: [id], onDelete: Cascade)

  @@index([status, scheduledFor])
  @@index([recipientUserId, scheduledFor])
  @@index([appointmentId])
  @@index([followUpId])
}

model CalendarConnection {
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique @db.Uuid

  provider       CalendarProvider
  accessToken    String
  refreshToken   String
  tokenExpiresAt DateTime?        @db.Timestamptz(3)
  calendarId     String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([provider])
}

model AuditLog {
  id          String  @id @default(uuid()) @db.Uuid
  actorUserId String? @db.Uuid

  action     String
  entityType String
  entityId   String?
  metadata   Json?

  createdAt DateTime @default(now()) @db.Timestamptz(3)

  actor User? @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId, createdAt])
  @@index([entityType, entityId])
  @@index([action, createdAt])
}
