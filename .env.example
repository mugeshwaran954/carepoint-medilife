# Application
NODE_ENV=development
PORT=5000

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/healthcare_appointment

# Authentication
JWT_SECRET=replace_with_a_secure_secret
JWT_EXPIRES_IN=1d

# Frontend
FRONTEND_URL=http://localhost:5173

# Redis
REDIS_URL=redis://localhost:6379

# Email
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# LLM
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=

# Google Calendar
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/v1/calendar/google/callback